@using DoffinCaseman.Web.Data.Entities

<fieldset class="assignee-picker">
    <legend>Assignees</legend>
    @foreach (var user in Users)
    {
        <label class="toggle">
            <input type="checkbox"
                   checked="@AssigneeIds.Contains(user.Id)"
                   @onchange="e => OnToggled(user.Id, e.Value is true)" />
            @user.DisplayName
        </label>
    }
</fieldset>

@code {
    [Parameter]
    public IReadOnlyCollection<Guid> AssigneeIds { get; set; } = [];

    [Parameter]
    public List<ApplicationUser> Users { get; set; } = [];

    // (userId, isAssigned) -- one user at a time so concurrent edits by
    // different people don't overwrite each other.
    [Parameter]
    public EventCallback<(Guid UserId, bool Assigned)> AssigneeToggled { get; set; }

    private Task OnToggled(Guid userId, bool assigned) =>
        AssigneeToggled.InvokeAsync((userId, assigned));
}
