@using Microsoft.AspNetCore.Components.Web
@inject IWebHostEnvironment Environment
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doffin Case Management</title>
    <base href="/" />
    <link rel="stylesheet" href="@Versioned("css/site.css")" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Versioned("js/theme.js")" defer></script>
</body>
</html>

@code {
    // Static files are served without fingerprinting, so browsers keep stale
    // copies across deploys. Appending the file's timestamp busts that cache
    // whenever the file changes.
    private string Versioned(string path)
    {
        var file = Environment.WebRootFileProvider.GetFileInfo(path);
        return file.Exists ? $"{path}?v={file.LastModified.ToUnixTimeSeconds()}" : path;
    }
}
