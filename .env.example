# Copy to .env and fill in real values. .env is gitignored.

POSTGRES_PASSWORD=changeme

# From the Doffin Public API developer portal: sign in and get your key at
# dof-notices-prod-api.developer.azure-api.net. Actual API calls go to a
# DIFFERENT host (api.doffin.no) -- see DOFFIN_API_BASE_URL below and
# docs/doffin-api-notes.md.
DOFFIN_API_SUBSCRIPTION_KEY=

# Leave unset to use the confirmed default. Confirmed live 2026-09-29 --
# see docs/doffin-api-notes.md. Do NOT use *.azure-api.net or
# *.developer.azure-api.net here; those are the docs portal, not the API.
# DOFFIN_API_BASE_URL=https://api.doffin.no

# Comma-separated. At least one of these two must be set.
DOFFIN_CPV_CODES=72000000

# NUTS-style location codes (e.g. NO081 = Oslo), NOT display names --
# "Oslo" or the portal's own example "Oslo og viken" both silently match
# zero results. Confirmed live by inspecting real hits' locationId values;
# see docs/doffin-api-notes.md for how to find the code for another region.
DOFFIN_REGIONS=NO081

DOFFIN_PAGE_SIZE=100
CRAWL_SCHEDULE_CRON=0 3 * * *
LOG_LEVEL=info
